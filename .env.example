# Datenbank (Entwicklung: `npm run dev:db` startet Postgres auf Port 54330)
DATABASE_URL=postgresql://postgres:postgres@localhost:54330/community
# Session-Signatur (mind. 32 Zeichen): openssl rand -base64 48
SESSION_SECRET=change-me-change-me-change-me-change-me
# Rolle: "all" (Entwicklung), im Cluster "web" bzw. "worker" (Mail-Outbox, Jobs)
APP_ROLE=all

# Domains – Hauptseite und Community-Subdomains <slug>.ROOT_DOMAIN.
# Entwicklung über lvh.me (*.lvh.me → 127.0.0.1), damit Subdomains und gemeinsames Cookie funktionieren.
APP_URL=http://www.lvh.me:3000
ROOT_DOMAIN=lvh.me:3000
COOKIE_DOMAIN=.lvh.me
APP_NAME=15k
APP_TIMEZONE=Europe/Berlin

# E-Mail: "log" (nur protokollieren), "smtp" (+ SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD)
# oder "brevo" (+ BREVO_API_KEY); dazu MAIL_FROM_ADDRESS (beim Anbieter verifiziert) und MAIL_FROM_NAME
MAIL_PROVIDER=log
MAIL_FROM_ADDRESS=noreply@15k.de
MAIL_FROM_NAME=15k

# Bildspeicher: S3-kompatibel (MinIO). Ist S3_BUCKET leer, wird lokal in UPLOAD_DIR gespeichert.
# Lokales MinIO: docker compose up -d (API :9002, Konsole :9003, minioadmin/minioadmin)
S3_ENDPOINT=http://localhost:9002
S3_BUCKET=community-images
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
UPLOAD_DIR=./uploads

# Jobsteuerung: Token für POST /api/jobs/run (Kubernetes-CronJob), mind. 32 Zeichen
JOB_TOKEN=

# Site-Admins (dürfen Communities anlegen), kommagetrennt
SITE_ADMIN_EMAILS=

# Betreiber und Pflichtangaben (Footer, Registrierung, E-Mails)
OPERATOR_NAME=Altiros GmbH
IMPRINT_URL=https://www.altiros.com/imprint
PRIVACY_URL=https://www.altiros.com/privacy
